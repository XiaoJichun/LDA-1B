FROM nvidia/cuda:12.1.1-cudnn8-devel-ubuntu22.04

ENV TZ=Asia/Shanghai \
    DEBIAN_FRONTEND=noninteractive \
    PATH=/opt/miniconda3/bin:$PATH

# 切换 apt 源为阿里云镜像
RUN sed -i 's|http://archive.ubuntu.com/ubuntu/|https://mirrors.aliyun.com/ubuntu/|g' /etc/apt/sources.list \
    && sed -i 's|http://security.ubuntu.com/ubuntu|https://mirrors.aliyun.com/ubuntu|g' /etc/apt/sources.list

WORKDIR /workspace

# 安装基本工具及 python3-pip（用于安装 uv，代替 ghcr.io 方式）
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget vim git git-lfs net-tools linux-headers-generic build-essential clang \
    cmake g++ gcc curl python3-pip \
    libglib2.0-0 libgl1-mesa-glx libgl1-mesa-dri \
    libsm6 libxext6 libxrender-dev libgomp1 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# 配置 pip 国内镜像（清华），并安装 uv（含 uvx）
RUN pip3 config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple \
    && pip3 config set global.trusted-host pypi.tuna.tsinghua.edu.cn \
    && pip3 install uv

# 安装 Miniconda（北京外国语大学镜像）
RUN wget -O /opt/miniconda.sh "https://mirrors.bfsu.edu.cn/anaconda/miniconda/Miniconda3-py310_25.1.1-1-Linux-x86_64.sh" \
 && chmod +x /opt/miniconda.sh \
 && /bin/bash /opt/miniconda.sh -b -p /opt/miniconda3 \
 && rm /opt/miniconda.sh

# 配置 conda 国内镜像（清华）
RUN /opt/miniconda3/bin/conda config --add channels https://mirrors.tuna.tsinghua.edu.cn/anaconda/pkgs/main/ \
    && /opt/miniconda3/bin/conda config --add channels https://mirrors.tuna.tsinghua.edu.cn/anaconda/pkgs/free/ \
    && /opt/miniconda3/bin/conda config --add channels https://mirrors.tuna.tsinghua.edu.cn/anaconda/cloud/conda-forge/ \
    && /opt/miniconda3/bin/conda config --set show_channel_urls yes

SHELL ["/bin/bash", "--login", "-c"]
